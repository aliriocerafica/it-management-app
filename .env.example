# Pooled connection for the app (Neon pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct connection for Prisma CLI (migrations, db pull, db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# 32-byte key, base64-encoded, used to encrypt sensitive fields (e.g. anydeskAddress).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Brevo transactional email (leave blank for local dev — email sending logs to console instead)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="it@ardentparalegal.com"
BREVO_SENDER_NAME="IT Asset Management"
