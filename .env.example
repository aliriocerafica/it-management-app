# Pooled connection for the app (Neon pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct connection for Prisma CLI (migrations, db pull, db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# 32-byte key, base64-encoded, used to encrypt sensitive fields (e.g. anydeskAddress).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Brevo transactional email (leave blank for local dev — email sending logs to console instead)
# Must be a sender verified in Brevo. Replies go to BREVO_REPLY_TO if set.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="IT Asset Management"
BREVO_REPLY_TO="it@ardentparalegal.com"

# Public site URL used in email links (Copy code). Optional locally.
APP_URL="http://localhost:3000"

# HRIS employee directory (ardent-hris-app GET /api/integrations/employees).
# Local: HRIS on port 3001. Vercel: the public HRIS origin, e.g. https://hris.example.com
HRIS_API_URL="http://localhost:3001"
IT_SYSTEM_API_KEY=""

# AURA (DTR) asset requests. Same value as DTR's DTR_INTERNAL_API_KEY.
# Sent as the x-internal-api-key header.
DTR_API_URL="http://localhost:3001"
DTR_INTERNAL_API_KEY=""
