generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Employees are not stored here. They come from the other system's
// employee API. Inventory rows keep `employeeId` plus a name/department
// snapshot so assignment history still displays if the API is unavailable.

enum AssetStatus {
  IN_USE
  VACANT
  IN_REPAIR
  RETIRED
}

enum AccessoryKind {
  HEADSET
  MOUSE
  MONITOR
  BAG
  BATTERY
  KEYBOARD
  RAM
}

enum ChargerCondition {
  GOOD
  WORN_CABLE
  REPLACED
  MISSING
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  // A small data: URL (resized client-side before upload). Null for the
  // default initials avatar.
  avatarUrl           String?
  role                UserRole  @default(ADMIN)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  // Invited by email and hasn't chosen a password yet; the stored hash is
  // of a random value nobody knows, so sign-in is impossible until then.
  mustSetPassword     Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  resetOtps           PasswordResetOtp[]
  setupTokens         AccountSetupToken[]

  @@map("users")
}

model AccountSetupToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("account_setup_tokens")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  userAgent    String?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_otps")
}

model Laptop {
  id            String      @id @default(cuid())
  assetTag      String      @unique
  brand         String
  model         String
  serialNumber  String      @unique
  cpu           String
  ram           String
  storage       String
  os            String
  color         String
  colorHex      String
  employeeId    String?
  handlerName   String?
  department    String?
  purchaseDate  DateTime    @db.Date
  warrantyYears  Int
  // Acquisition cost. Null for units added before this was tracked.
  price          Float?
  status         AssetStatus
  // What's wrong and still needs fixing. Kept after the laptop leaves
  // repair, so it can go back into use with a repair still pending.
  repairIssue    String?
  anydeskAddress String?
  createdAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  charger       LaptopCharger?
  assignments   LaptopAssignment[]
  // RAM modules installed in this laptop.
  installedParts Accessory[]

  @@index([employeeId])
  @@index([status])
  @@map("laptops")
}

model LaptopCharger {
  id           String           @id @default(cuid())
  laptopId     String           @unique
  laptop       Laptop           @relation(fields: [laptopId], references: [id], onDelete: Cascade)
  connector    String
  wattage      Int
  partNumber   String
  serialNumber String
  condition    ChargerCondition

  @@map("laptop_chargers")
}

model LaptopAssignment {
  id          String    @id @default(cuid())
  laptopId    String
  laptop      Laptop    @relation(fields: [laptopId], references: [id], onDelete: Cascade)
  employeeId  String?
  handlerName String?
  department  String?
  from        DateTime  @db.Date
  to          DateTime? @db.Date
  note        String?
  createdAt   DateTime  @default(now())

  @@index([laptopId])
  @@index([employeeId])
  @@map("laptop_assignments")
}

model Accessory {
  id            String        @id @default(cuid())
  kind          AccessoryKind
  assetTag      String        @unique
  brand         String
  model         String
  // Not unique: consumables like mice and batteries often carry a shared
  // batch/lot number. Asset tags stay unique per unit.
  serialNumber  String
  color         String
  colorHex      String
  employeeId    String?
  handlerName   String?
  department    String?
  purchaseDate  DateTime      @db.Date
  warrantyYears Int
  // Acquisition cost. Null for units added before this was tracked.
  price         Float?
  status        AssetStatus
  specs         Json
  // Fault still waiting to be fixed; may be set while the item is in use.
  repairIssue   String?
  // For RAM: the laptop it's installed in, instead of a person. Installing
  // or removing a module adjusts that laptop's `ram` total.
  laptopId      String?
  laptop        Laptop?       @relation(fields: [laptopId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  assignments   AccessoryAssignment[]

  @@index([kind])
  @@index([laptopId])
  @@index([serialNumber])
  @@index([employeeId])
  @@index([status])
  @@map("accessories")
}

model AccessoryAssignment {
  id          String     @id @default(cuid())
  accessoryId String
  accessory   Accessory  @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  employeeId  String?
  handlerName String?
  department  String?
  from        DateTime   @db.Date
  to          DateTime?  @db.Date
  note        String?
  createdAt   DateTime   @default(now())

  @@index([accessoryId])
  @@index([employeeId])
  @@map("accessory_assignments")
}

model AccountabilityFormSettings {
  id            String   @id
  hrName        String
  // From when HR was a single signatory kept on this row. Only read to
  // start the HR signatory list; see AccountabilityFormSignatory.
  hrSignature   String?
  hrEmail       String?
  itOfficerName String
  updatedAt     DateTime @updatedAt

  @@map("accountability_form_settings")
}

// Someone who can sign accountability forms as the IT Officer or as Human
// Resource, with the signature image printed above their name when one is
// on file.
model AccountabilityFormSignatory {
  id        String   @id @default(cuid())
  // "IT" or "HR": which line of the form they sign.
  role      String   @default("IT")
  name      String
  // Copied on forms they sign when those are emailed to holders.
  email     String?
  // A small PNG or JPEG as a data URL.
  signature String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("accountability_form_signatories")
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  DENIED
  ARCHIVED
  DELETED
}

enum AssetRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// An employee's request for IT equipment. Approved until handed over
// (Completed), denied, or archived.
model AssetRequest {
  id            String               @id @default(cuid())
  requestNo     Int                  @unique @default(autoincrement())
  employeeId    String?
  requesterName String
  requesterEmail String?
  department    String?
  assetType     String
  quantity      Int                  @default(1)
  reason        String
  priority      AssetRequestPriority @default(NORMAL)
  status        AssetRequestStatus   @default(PENDING)
  neededBy      DateTime?            @db.Date
  // Why it was denied, or what was handed over when completed.
  resolutionNote String?
  approvedAt    DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([employeeId])
  @@map("asset_requests")
}

// DTR requests live in AURA. IT-side approve / deny / archive is stored here
// when the DTR row should not keep its original status in this queue.
model AssetRequestOverride {
  requestId String             @id
  status    AssetRequestStatus
  note      String?
  updatedAt DateTime           @updatedAt @default(now())

  @@map("asset_request_overrides")
}

// One generated accountability form. Each holder gets a new version when
// their assigned equipment changes; the PDF is re-rendered from this
// snapshot, so every version downloads exactly as it was issued.
model AccountabilityForm {
  id            String   @id @default(cuid())
  holderName    String
  employeeId    String?
  department    String?
  version       Int
  hrName        String
  itOfficerName String
  generatedOn   String
  // EquipmentRow[] as printed on the form.
  equipment     Json
  // Sorted equipment fingerprint, to tell when a form is out of date.
  signature     String
  createdByName String?
  createdAt     DateTime @default(now())
  // When the printed copy came back signed by the holder; null while
  // that's still pending. Recorded by hand.
  signedAt      DateTime?
  signedByName  String?
  sends         AccountabilityFormSend[]
  signLinks     AccountabilityFormSignLink[]

  @@unique([holderName, version])
  @@index([holderName])
  @@map("accountability_forms")
}

model AccountabilityFormSend {
  id         String             @id @default(cuid())
  formId     String
  form       AccountabilityForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  toEmail    String
  sentByName String?
  sentAt     DateTime           @default(now())

  @@index([formId])
  @@map("accountability_form_sends")
}

// A private link emailed with a form so its holder can upload the signed
// copy without an account. The upload is recorded on the link it came in
// on; the file itself lives in private Vercel Blob storage.
model AccountabilityFormSignLink {
  id          String             @id @default(cuid())
  formId      String
  form        AccountabilityForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  tokenHash   String             @unique
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  fileName    String?
  contentType String?
  blobUrl     String?
  uploadedAt  DateTime?

  @@index([formId])
  @@map("accountability_form_sign_links")
}
