generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Employees are not stored here. They come from the other system's
// employee API. Inventory rows keep `employeeId` plus a name/department
// snapshot so assignment history still displays if the API is unavailable.

enum AssetStatus {
  IN_USE
  VACANT
  IN_REPAIR
  RETIRED
}

enum AccessoryKind {
  HEADSET
  MOUSE
  MONITOR
  BAG
  BATTERY
  KEYBOARD
}

enum ChargerCondition {
  GOOD
  WORN_CABLE
  REPLACED
  MISSING
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(ADMIN)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  resetOtps           PasswordResetOtp[]

  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  userAgent    String?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_otps")
}

model Laptop {
  id            String      @id @default(cuid())
  assetTag      String      @unique
  brand         String
  model         String
  serialNumber  String      @unique
  cpu           String
  ram           String
  storage       String
  os            String
  color         String
  colorHex      String
  employeeId    String?
  handlerName   String?
  department    String?
  purchaseDate  DateTime    @db.Date
  warrantyYears  Int
  status         AssetStatus
  // What's wrong and still needs fixing. Kept after the laptop leaves
  // repair, so it can go back into use with a repair still pending.
  repairIssue    String?
  anydeskAddress String?
  createdAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  charger       LaptopCharger?
  assignments   LaptopAssignment[]

  @@index([employeeId])
  @@index([status])
  @@map("laptops")
}

model LaptopCharger {
  id           String           @id @default(cuid())
  laptopId     String           @unique
  laptop       Laptop           @relation(fields: [laptopId], references: [id], onDelete: Cascade)
  connector    String
  wattage      Int
  partNumber   String
  serialNumber String
  condition    ChargerCondition

  @@map("laptop_chargers")
}

model LaptopAssignment {
  id          String    @id @default(cuid())
  laptopId    String
  laptop      Laptop    @relation(fields: [laptopId], references: [id], onDelete: Cascade)
  employeeId  String?
  handlerName String?
  department  String?
  from        DateTime  @db.Date
  to          DateTime? @db.Date
  note        String?
  createdAt   DateTime  @default(now())

  @@index([laptopId])
  @@index([employeeId])
  @@map("laptop_assignments")
}

model Accessory {
  id            String        @id @default(cuid())
  kind          AccessoryKind
  assetTag      String        @unique
  brand         String
  model         String
  // Not unique: consumables like mice and batteries often carry a shared
  // batch/lot number. Asset tags stay unique per unit.
  serialNumber  String
  color         String
  colorHex      String
  employeeId    String?
  handlerName   String?
  department    String?
  purchaseDate  DateTime      @db.Date
  warrantyYears Int
  status        AssetStatus
  specs         Json
  // Fault still waiting to be fixed; may be set while the item is in use.
  repairIssue   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  assignments   AccessoryAssignment[]

  @@index([kind])
  @@index([serialNumber])
  @@index([employeeId])
  @@index([status])
  @@map("accessories")
}

model AccessoryAssignment {
  id          String     @id @default(cuid())
  accessoryId String
  accessory   Accessory  @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  employeeId  String?
  handlerName String?
  department  String?
  from        DateTime   @db.Date
  to          DateTime?  @db.Date
  note        String?
  createdAt   DateTime   @default(now())

  @@index([accessoryId])
  @@index([employeeId])
  @@map("accessory_assignments")
}

model AccountabilityFormSettings {
  id            String   @id
  hrName        String
  itOfficerName String
  updatedAt     DateTime @updatedAt

  @@map("accountability_form_settings")
}
